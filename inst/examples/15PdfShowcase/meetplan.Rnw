<<init, echo = FALSE, include = FALSE>>=
knitr::opts_chunk$set(echo = FALSE, fig.align = "left")

ovzItems <- reportVars$ovzItems
mcmnts <- reportVars$mcmnts
widgets <- reportVars$rapData
afdeling <- reportVars$afdeling
periode <- reportVars$periode
tbl <- reportVars$tbl
score <- reportVars$scr
realNaam <- reportVars$realNaam

i <- 1

genPre <- function(grp,grpCode) {
    
    color <- score$score[score$kpiCode == grpCode]
    ret  <- paste0('\\subsection{',grp,'}')
    
    if (length(color) > 0)
        ret <- paste0(ret,'Aandacht:\\hspace{0.2cm}\\textcolor{', color, '}{\\colorbox{', color, '}{A}}')
    
    if (length(mcmnts$txt[mcmnts$kpiCode == grpCode & mcmnts$type == 'meetp1']) > 0) {
        ret <- paste0(ret, '\\subsubsection{Aanleiding}')
        ret <- paste0(ret, mcmnts$txt[mcmnts$kpiCode == grpCode & mcmnts$type == 'meetp1'])
    }
    
    if (length(mcmnts$txt[mcmnts$kpiCode == grpCode & mcmnts$type == 'meetp2']) > 0) {
        ret <- paste0(ret, '\\subsubsection{Doelstelling}')
        ret <- paste0(ret, mcmnts$txt[mcmnts$kpiCode == grpCode & mcmnts$type == 'meetp2'])
    }
    
    if (length(mcmnts$txt[mcmnts$kpiCode == grpCode & mcmnts$type == 'meetp3']) > 0) {
        ret <- paste0(ret, '\\subsubsection{Voortgang}')
        ret <- paste0(ret, mcmnts$txt[mcmnts$kpiCode == grpCode & mcmnts$type == 'meetp3'])
    }
    
    if (length(mcmnts$txt[mcmnts$kpiCode == grpCode & mcmnts$type == 'meetp4']) > 0) {
        ret <- paste0(ret, '\\subsubsection{Bijstellen (Act)}')
        ret <- paste0(ret, mcmnts$txt[mcmnts$kpiCode == grpCode & mcmnts$type == 'meetp4'])
    }
    
    ret
}
@

\graphicspath{{\Sexpr{reportVars$wwwDir}}}

\fancyhf{}  % clear header en footer

