\begin{document}

\tableofcontents
\newpage

<<conclusie, echo = FALSE, fig.cap='', fig.pos = 'H', results = 'asis'>>=
cat(paste0('\\section{Management samenvatting}'))
cat(mcmnts$txt[mcmnts$kpiCode == 'MP' & mcmnts$type == 'conc'])
@

\newpage
\section{Overzicht Kwaltiteit en Veiligheid indicatoren \Sexpr{latexEscape(afdeling)}}

<<overzicht, echo = FALSE, resuls = 'asis'>>=

for (cc in 1:length(tbl))
  tbl[,cc] <- latexEscape(tbl[,cc])

tbl$rownum <- 1:nrow(tbl)

if (!all(tbl$posneg == 0)) {
  
  background = ifelse(tbl$posneg == -1, 'pink', 
                      ifelse(tbl$posneg == 1, 'light-green', 'white'))
  
  tbl$Verschil <- paste0('\\colorbox{',background,'}{',tbl$Verschil,'}')
}

tbl$posneg <- NULL

tbl$Naam <- cell_spec(
  x = tbl$Naam,
  format = "latex",
  background = ifelse(tbl$rownum %% 2 != 1, 'white','light-gray'),
  escape = FALSE)

tbl$rownum <- NULL

names(tbl) <- c(' ','Naam', realNaam, 'Groen','Rood', 'Norm', 'Verschil')

kbl(
    tbl,
    format = 'latex',
    row.names = FALSE, 
    booktabs = TRUE,
    longtable = TRUE,
    escape = FALSE, 
    align = c('l','l','r','r','r','r','r','r'), 
    linesep = "") %>%
    kable_styling(
        latex_options = c("hold_position","repeat_header"),
        full_width = FALSE,
        font_size = 10,
        repeat_header_text = "\\textit{vervolg indicatoren}") %>%
    column_spec(
        1, 
        width = "0.1cm") %>%
    column_spec(
        2, 
        width = "8cm") %>%
    collapse_rows(columns = c(1,2), latex_hline = 'none', row_group_label_position = 'stack')

@


<<build-src, include=FALSE>>=
src <- ""
for (grp in unique(ovzItems$ovzGrp)) {
    
    grpCode <- unique(ovzItems$ovzGrpCode[ovzItems$ovzGrp == grp])
    src <- paste0(src,genPre(grp,grpCode))
    
    src <- paste0(src,"\\subsubsection{Indicatoren ",grp,"}")
    
    for (kpi in unique(ovzItems$kpiLabel[ovzItems$ovzGrpCode == grpCode])) {
        src <- paste0(src,"\\paragraph*{",latexEscape(kpi),"}")
        
        src <- paste0(src,"\n
\\begin{figure}[H]
  \\centering
  \\includegraphics[width=.9\\textwidth]{",widgets[[i]],"}%
\\end{figure}
\\begin{figure}[H]
  \\centering
  \\includegraphics[width=.9\\textwidth]{",widgets[[i + 1]],"}%
\\end{figure}")
        
        i <- i + 2
    }
    
}
@

% write the results now
\Sexpr{knit(text = src)}

\end{document}
